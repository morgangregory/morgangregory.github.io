Total_Score <- Total_Score |> mutate(Total_Points_Final = Total_Points + Def_scoring + K_scoring) |> select(Tm, Total_Points_Final)
head(Total_Score)
Total_Score$rank <- rank(Total_Score$Total_Points_Final)
Real_Ranking <- c(4, 11, 32, 28, 1, 10, 20, 27, 31, 13, 30, 19, 23, 18, 17, 26, 5, 22, 12, 25, 9, 16, 3, 7, 8, 24, 21, 15, 29, 14, 6, 2)
Total_Score <- data.frame(Total_Score, Real_Ranking)
Total_Score
#| label: fig-1
#| fig-cap: "A scatterplot showing the relationship between each NFL team's real-life ranking and their fantasy ranking. Note: Rank 32 is the best, and rank 1 is the worst."
ggplot(Total_Score, aes(x = Real_Ranking, y = rank, label = Tm)) + geom_point() + theme_bw() + xlab("Real Life Ranking") + ylab("Fantasy Ranking") + geom_text(vjust = 1.5)
num_wins <- c(4, 7, 13, 11, 2, 7, 9, 11, 12, 8, 12, 9, 10, 9, 9, 11, 5, 10, 8, 11, 7, 9, 4, 6, 7, 11, 10, 9, 12, 9, 6, 4)
Total_Score <- data.frame(Total_Score, num_wins)
#| label: fig-2
#| fig-cap: "A scatterplot showing the relationship between each NFL team's number of wins and theit total number of fantasy points scored."
ggplot(Total_Score, aes(x = num_wins, y = Total_Points_Final, label = Tm)) + geom_point() + theme_bw() + xlab("# of Wins") + ylab("Total Fantasy Points Scored") + scale_x_continuous(breaks = c(2, 4, 6, 8, 10, 12, 14, 16)) + geom_text_repel()
PlayerScoringPerGame <- read_csv("PlayerScoringPerGame.csv")
head(PlayerScoringPerGame)
PlayerScoringPerGame <- PlayerScoringPerGame |> select(Player, Tm, FantPos, PPR) |> filter(Tm != "3TM" & Tm != "2TM") |> filter(FantPos == "RB" | FantPos == "WR") |> arrange(desc(PPR))
BestWrRBPerTeam <- PlayerScoringPerGame |> group_by(Tm, FantPos) |> summarize(BestPlayer = max(PPR, na.rm = TRUE))
BestWrRBPerTeam
BestWRPerTeam <- BestWrRBPerTeam |> filter(FantPos == "WR")
colnames(BestWRPerTeam) <- c("Tm", "FantPos", "BestWRAvg")
BestRBPerTeam <- BestWrRBPerTeam |> filter(FantPos == "RB")
colnames(BestRBPerTeam) <- c("Tm", "FantPos", "BestRBAvg")
RB_WR_Comp <- data.frame(BestWRPerTeam, BestRBPerTeam)
RB_WR_Comp <- RB_WR_Comp |> select(Tm, BestWRAvg, BestRBAvg) |> mutate(Difference = abs(BestWRAvg - BestRBAvg))
RB_WR_Comp
#| label: fig-3
#| fig-cap: "A scatterplot showing the relationship between each NFL team's top fantasy RB and WR."
ggplot(RB_WR_Comp, aes(x = BestRBAvg, y = BestWRAvg, label = Tm)) + geom_point() + geom_text_repel() + scale_x_continuous(breaks = c(5, 10, 15, 20, 25)) + scale_y_continuous(breaks = c(5, 10, 15, 20, 25)) + geom_abline(intercept = 0, slope = 1, color = "red") + theme_bw() + xlab("Top RB Points Per Game") + ylab("Top WR Points Per Game")
PlayerScoringPerGame
cor(RB_WR_Comp$BestRBAvg, RB_WR_Comp$BestWRAvg)
