Total_Score$rank <- rank(Total_Score$Total_Points_Final)
Real_Ranking <- c(4, 11, 32, 28, 1, 10, 20, 27, 31, 13, 30, 19, 23, 18, 17, 26, 5, 22, 12, 25, 9, 16, 3, 7, 8, 24, 21, 15, 29, 14, 6, 2)
Total_Score <- data.frame(Total_Score, Real_Ranking)
Total_Score
ggplot(Total_Score, aes(x = Real_Ranking, y = rank, label = Tm)) + geom_point(color = "red") + theme_bw() + xlab("Real Life Ranking") + ylab("Fantasy Ranking") + geom_text(vjust = 1.5)
num_wins <- c(4, 7, 13, 11, 2, 7, 9, 11, 12, 8, 12, 9, 10, 9, 9, 11, 5, 10, 8, 11, 7, 9, 4, 6, 7, 11, 10, 9, 12, 9, 6, 4)
Total_Score <- data.frame(Total_Score, num_wins)
library(ggrepel)
ggplot(Total_Score, aes(x = num_wins, y = Total_Points_Final, label = Tm)) + geom_point() + theme_bw() + xlab("# of Wins") + ylab("Total Fantasy Points Scored") + scale_x_continuous(breaks = c(2, 4, 6, 8, 10, 12, 14, 16)) + geom_text_repel()
library(readr)
PlayerScoringPerGame <- read_csv("PlayerScoringPerGame.csv")
head(PlayerScoringPerGame)
PlayerScoringPerGame <- PlayerScoringPerGame |> select(Player, Tm, FantPos, PPR) |> filter(Tm != "3TM" & Tm != "2TM") |> filter(FantPos == "RB" | FantPos == "WR") |> arrange(desc(PPR))
BestWrRBPerTeam <- PlayerScoringPerGame |> group_by(Tm, FantPos) |> summarize(BestPlayer = max(PPR, na.rm = TRUE))
BestWrRBPerTeam
BestWRPerTeam <- BestWrRBPerTeam |> filter(FantPos == "WR")
colnames(BestWRPerTeam) <- c("Tm", "FantPos", "BestWRAvg")
BestRBPerTeam <- BestWrRBPerTeam |> filter(FantPos == "RB")
colnames(BestRBPerTeam) <- c("Tm", "FantPos", "BestRBAvg")
RB_WR_Comp <- data.frame(BestWRPerTeam, BestRBPerTeam)
RB_WR_Comp <- RB_WR_Comp |> select(Tm, BestWRAvg, BestRBAvg) |> mutate(Difference = abs(BestWRAvg - BestRBAvg))
RB_WR_Comp
ggplot(RB_WR_Comp, aes(x = BestRBAvg, y = BestWRAvg, label = Tm)) + geom_point() + geom_text_repel() + scale_x_continuous(breaks = c(5, 10, 15, 20, 25)) + scale_y_continuous(breaks = c(5, 10, 15, 20, 25)) + geom_abline(intercept = 0, slope = 1, color = "red") + theme_bw()
PlayerScoringPerGame
cor(RB_WR_Comp$BestRBAvg, RB_WR_Comp$BestWRAvg)
PosnValue <- read_csv("PosnValue.csv")
View(PosnValue)
Position_data <- PosnValue |> select(Rk, FantPos, PPR) |> group_by(FantPos)
ggplot(Position_data, aes(x = PPR, fill = FantPos)) + geom_histogram(binwidth = 1, color = "black") + facet_wrap(~FantPos) + theme_bw()
ggplot(Position_data, aes(y = PPR, x = FantPos, fill = FantPos)) + geom_boxplot() + theme_bw()
ggplot(Position_data, aes(x = Rk, y = PPR, color = FantPos)) + geom_point(size = 2.5) + theme_bw()
QB_data <- PosnValue |> filter(FantPos == "QB") |> select(Rk, Player, PPR) |> arrange(Rk)
QB_data <- QB_data[1:15,]
Tier <- c("Top", "Top", "Top", "Top", "Top", "Mid", "Mid", "Mid", "Mid", "Mid", "Bottom", "Bottom", "Bottom", "Bottom", "Bottom")
QB_data_tiered <- data.frame(QB_data, Tier)
QB_data_tiered
ggplot(QB_data_tiered, aes(x = factor(Tier), y = PPR)) + geom_boxplot() + theme_bw()
QB_data_tiered$Tier <- c("Top", "Top", "Top", "Top", "Not", "Not", "Not", "Not", "Not", "Not", "Not", "Not", "Not", "Not", "Not")
ggplot(QB_data_tiered, aes(x = factor(Tier), y = PPR)) + geom_boxplot() + theme_bw()
AgeData <- read_csv("AgeData.csv", show_col_types = FALSE)
AgeData <- AgeData[1:180, ]
head(AgeData)
ggplot(AgeData, aes(x = Age, fill = FantPos)) + geom_histogram(binwidth = 1, color = "Black") + theme_bw()
ggplot(AgeData, aes(x = Age, y = PPR)) + geom_point() + geom_smooth(method = "lm", se = FALSE) + theme_bw()
AgeAverages <- AgeData |> group_by(Age) |> summarize(MeanScore = mean(PPR))
ggplot(AgeAverages, aes(x = Age, y = MeanScore)) + geom_point() + theme_bw() + geom_smooth(method = "loess", se = FALSE)
ggplot(AgeData, aes(x = Age, y = PPR, color = FantPos)) + geom_point() + geom_smooth(method = "lm", se = FALSE) + theme_bw() + facet_wrap(~ FantPos)
AgeAverages_p <- AgeData |> group_by(Age, FantPos) |> summarize(MeanScore = mean(PPR))
ggplot(AgeAverages_p, aes(x = Age, y = MeanScore, color = FantPos)) + geom_point() + geom_smooth(method = "loess", se = FALSE) + theme_bw()
AgeData_Top <- AgeData[1:120, ]
AgeData_Top_Avg <- AgeData_Top |> group_by(Age) |> summarize(MeanG = mean(G))
ggplot(AgeData_Top_Avg, aes(x = Age, y = MeanG)) + geom_point() + theme_bw()
AgeData_Inj <- AgeData_Top |> group_by(Age) |> filter(G <= 15) |> summarize(MeanG = mean(G))
ggplot(AgeData_Inj, aes(x = Age, y = MeanG)) + geom_point() + geom_smooth(method = "loess", se = FALSE) + theme_bw()
Untitled_spreadsheet_2023stats <- read_csv("Untitled spreadsheet - 2023stats.csv", show_col_types = FALSE)
View(Untitled_spreadsheet_2023stats)
Yearly_data <- Untitled_spreadsheet_2023stats
Yearly_data <- Yearly_data |> group_by(Year) |> summarize(AvgPPG = mean(PPR))
